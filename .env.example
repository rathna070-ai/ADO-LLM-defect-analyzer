# Copy to .env and fill in. .env is gitignored at the repo root — never commit real values.
# Every variable Config.from_env() reads is listed here; tests/test_config.py
# fails if the two ever drift apart.

# --- Azure DevOps ---
ADO_ORGANIZATION=your-org
ADO_PROJECT=your-project
ADO_PAT=your-personal-access-token
ADO_API_VERSION=7.1
ADO_WORK_ITEM_TYPE=Bug
# Optional: restrict to one area path, e.g. "YourProject\\Web"
ADO_AREA_PATH=
ADO_LOOKBACK_DAYS=180
# The reference name of whatever field you tag root cause with, if any.
ADO_ROOT_CAUSE_FIELD=Microsoft.VSTS.CMMI.RootCause
# Work items per workitemsbatch request (ADO caps this at 200).
ADO_BATCH_SIZE=200
# One REST call per defect to pull full comment threads (ADO has no batch
# comments endpoint). Off by default. Not needed at all with the Excel
# import path (`fetch --from-excel`) — comments come from the sheet instead.
ADO_FETCH_COMMENTS=false
ADO_REQUEST_TIMEOUT_SECONDS=30

# --- LLM provider ---
# "groq" is implemented today. "copilot" is a placeholder for a future
# GitHub Copilot / GitHub Models integration — see llm/copilot_provider.py.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Reserved for when the Copilot provider is implemented.
COPILOT_API_KEY=
COPILOT_MODEL=

LLM_REQUEST_TIMEOUT_SECONDS=60
# 0.0 keeps categorization deterministic run to run.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
# Defects per LLM call. Larger batches are cheaper but risk truncation.
LLM_CATEGORIZE_BATCH_SIZE=10

# --- Analysis ---
# Comma-separated resolution values that count as a rejected (not genuine)
# defect in the valid-vs-rejected split.
REJECTED_RESOLUTIONS=Duplicate,Cannot Reproduce,As Designed,By Design,Won't Fix,Not a Bug
# Categorizations below this confidence land in needs_review.csv.
REVIEW_CONFIDENCE_THRESHOLD=0.6

# --- Storage / output ---
# Relative paths resolve against the repo root, not the working directory.
DEFECT_DB_PATH=data/defects.db
DEFECT_OUTPUT_DIR=data/exports
