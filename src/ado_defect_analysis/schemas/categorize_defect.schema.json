{
  "type": "object",
  "description": "One categorization per defect in the batch you were given, in any order.",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "defect_id": {
            "type": "integer",
            "description": "Echo back the ADO work item id you were given for this defect."
          },
          "root_cause_category": {
            "type": "string",
            "enum": [
              "requirements_gap",
              "design_flaw",
              "coding_error",
              "data_defect",
              "integration_defect",
              "configuration_defect",
              "build_deployment_defect",
              "test_gap",
              "third_party_defect",
              "performance_defect",
              "security_defect",
              "not_a_defect",
              "unknown"
            ]
          },
          "testing_gap_flag": {
            "type": "boolean",
            "description": "true if better test coverage would plausibly have caught this before release."
          },
          "sdlc_phase": {
            "type": "string",
            "enum": [
              "requirements",
              "design",
              "development",
              "testing",
              "build_release",
              "production_operations",
              "not_applicable",
              "unknown"
            ],
            "description": "The SDLC phase where this defect's root cause was introduced or should have been caught."
          },
          "evidence": {
            "type": "string",
            "description": "Which field(s) drove the call, e.g. 'title + tag QA miss' or 'root_cause_raw'. One short phrase."
          },
          "summary": {
            "type": "string",
            "description": "One sentence, plain English, no jargon."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "defect_id",
          "root_cause_category",
          "testing_gap_flag",
          "sdlc_phase",
          "evidence",
          "summary",
          "confidence"
        ]
      }
    }
  },
  "required": ["results"]
}
